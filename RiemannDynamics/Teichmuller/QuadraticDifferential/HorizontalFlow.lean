  obtain ⟨hnnP, hnnR⟩ := nonnegWinding_transport₂ hW hd1 hgcρ hclρ hgclρ hinjρ hgne
  exact no_bigon_loop hUconv hUH hq hq0 hfin hd1 hgcρ hclρ hgclρ hinjρ hgne
